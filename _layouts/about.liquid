---
layout: default
---
<div class="post about-page">
  <article>
    <div class="about-grid">
      <header class="post-header about-header">
        <p class="eyebrow">Computational materials science</p>
        <h1 class="post-title">
          {% if site.title == 'blank' -%}
            {{- site.first_name }}
            {{ site.middle_name }}
            {{ site.last_name -}}
          {%- else -%}
            {{- site.title -}}
          {%- endif %}
        </h1>
        <p class="about-position">
          {{ page.subtitle -}}
          <br>
          <span>{{ page.affiliation }}</span>
        </p>
        <div class="profile-links">
          {% if site.email -%}
            <a href="mailto:{{ site.email | encode_email }}">Email <span aria-hidden="true">↗</span></a>
          {%- endif %}
          {% if site.scholar_userid -%}
            <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}"
              >Google Scholar <span aria-hidden="true">↗</span></a
            >
          {%- endif %}
          <a href="{{ '/cv/' | relative_url }}">Curriculum vitae <span aria-hidden="true">↗</span></a>
        </div>
      </header>
      {% if page.profile %}
        <aside class="profile about-profile" aria-label="Portrait and academic profiles">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% assign portrait_alt = site.first_name | append: ' ' | append: site.last_name %}
            {% assign portrait_class = 'img-fluid portrait' %}
            {% if page.profile.image_circular -%}
              {%- assign portrait_class = portrait_class | append: ' rounded-circle' -%}
            {%- endif %}
            {% include figure.liquid loading='eager' path=profile_image_path class=portrait_class sizes='(max-width: 575px) 120px, 220px' alt=portrait_alt cache_bust=true %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
          <div class="profile-social">{% include social.liquid %}</div>
        </aside>
      {% endif %}
      <div class="about-body">{{ content }}</div>
    </div>
    {% if page.news and site.announcements.enabled %}
      <section class="home-section" aria-labelledby="news-heading">
        <div class="section-heading">
          <h2 id="news-heading">News</h2>
          <a href="{{ '/news/' | relative_url }}">All news <span aria-hidden="true">↗</span></a>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}
    {% if site.latest_posts.enabled %}
      <section class="home-section">
        <div class="section-heading">
          <h2>Latest notes</h2>
          <a href="{{ '/blog/' | relative_url }}">All notes ↗</a>
        </div>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}
    {% if page.selected_papers %}
      <section class="home-section">
        <div class="section-heading">
          <h2>Selected publications</h2>
          <a href="{{ '/publications/' | relative_url }}">All publications ↗</a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
    {% if site.newsletter.enabled and site.footer_fixed %}{% include scripts/newsletter.liquid center=true %}{% endif %}
  </article>
</div>
